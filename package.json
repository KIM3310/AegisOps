{
  "name": "aegisops",
  "version": "0.1.0",
  "private": true,
  "description": "Multimodal incident copilot with replay evals, live-session review, and export surfaces.",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "build": "vite build",
    "preview": "vite preview",
    "eval:replays": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node --import tsx scripts/run-incident-replays.ts",
    "architecture:smoke": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node --import tsx scripts/architecture-surface-smoke.ts",
    "exercise:runtime": "node scripts/exercise-runtime.mjs",
    "load:runtime": "tsx scripts/load-runtime.ts",
    "load:k6": "k6 run scripts/k6-runtime-scorecard.js",
    "datadog:plan": "node scripts/datadog-assets.mjs plan",
    "datadog:sync": "node scripts/datadog-assets.mjs sync",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "verify": "npm run typecheck && npm test && npm run eval:replays && npm run architecture:smoke && npm run build",
    "benchmark:local": "tsx scripts/benchmark-local.ts",
    "cloud:build": "wrangler pages functions build --outdir .wrangler/compiled --output-routes-path .wrangler/compiled-routes.json --metafile .wrangler/bundle-meta.json --compatibility-date 2026-07-23 --compatibility-flags nodejs_compat && node scripts/check-cloud-build.mjs",
    "cloud:dev": "wrangler pages dev dist --ip 127.0.0.1 --port 8788 --local-protocol https",
    "cloud:proof": "node --import tsx scripts/cloud-response-proof.ts",
    "cloud:remote-proof": "node --import tsx scripts/cloud-remote-proof.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "dotenv": "^17.2.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^0.577.0",
    "openai": "^6.49.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@types/express": "^4.17.23",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "jsdom": "^26.0.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.5.28",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "4.132.0"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "qs": "^6.15.2",
    "shell-quote": "^1.8.4",
    "ws": "^8.20.1",
    "esbuild": "^0.28.1"
  },
  "author": "Doeon Kim",
  "homepage": "https://github.com/KIM3310/AegisOps",
  "repository": {
    "type": "git",
    "url": "https://github.com/KIM3310/AegisOps.git"
  },
  "keywords": [
    "incident-response",
    "multimodal-ai",
    "llm-evals",
    "solution-architecture",
    "react",
    "vite",
    "gemini",
    "ollama"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
